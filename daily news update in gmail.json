    {
      "parameters": {
        "jsCode": "// Collect all RSS data from 6 HTTP nodes\nconst items = $input.all();\n\nfunction cleanRSS(raw) {\n  if (!raw) return 'No data received';\n  let text = String(raw);\n  \n  // Remove CDATA\n  text = text.split('<![CDATA[').join('');\n  text = text.split(']]>').join('');\n  \n  // Remove all HTML/XML tags using split method (no regex)\n  let result = '';\n  let inside = false;\n  for (let i = 0; i < text.length; i++) {\n    if (text[i] === '<') { inside = true; continue; }\n    if (text[i] === '>') { inside = false; continue; }\n    if (!inside) result += text[i];\n  }\n  \n  // Fix common HTML entities\n  result = result.split('&amp;').join('&');\n  result = result.split('&lt;').join('<');\n  result = result.split('&gt;').join('>');\n  result = result.split('&quot;').join('\"');\n  result = result.split('&#39;').join(\"'\");\n  result = result.split('&nbsp;').join(' ');\n  \n  // Trim extra spaces\n  while (result.includes('  ')) {\n    result = result.split('  ').join(' ');\n  }\n  \n  return result.trim().substring(0, 2500);\n}\n\nconst global_biz    = cleanRSS(items[0] ? (items[0].json.data || items[0].json.body || '') : '');\nconst india_biz     = cleanRSS(items[1] ? (items[1].json.data || items[1].json.body || '') : '');\nconst textiles      = cleanRSS(items[2] ? (items[2].json.data || items[2].json.body || '') : '');\nconst ai_world      = cleanRSS(items[3] ? (items[3].json.data || items[3].json.body || '') : '');\nconst share_market  = cleanRSS(items[4] ? (items[4].json.data || items[4].json.body || '') : '');\nconst daily_vitals  = cleanRSS(items[5] ? (items[5].json.data || items[5].json.body || '') : '');\n\nreturn [{\n  json: {\n    global_biz,\n    india_biz,\n    textiles,\n    ai_world,\n    share_market,\n    daily_vitals\n  }\n}];"
      },
